<?xml version="1.0"?>
<!--
  wuji dexterous hand — genie_sim adapter (self-contained).

  Upstream model: wuji-hand-description
    https://github.com/wuji-technology/wuji-hand-description
    Copyright (c) 2025 Wuji Technology — MIT License.

  The kinematic tree (palm + 5 fingers × 4 revolute joints + fingertip
  pads), all per-side / per-finger numeric data (masses, inertias, joint
  origins, rpy, axes, limits), and the STL meshes under
  robots/genie/g2/meshes/gripper/wuji/ are derived from that upstream
  package and remain under its MIT license. See ../../../../THIRD_PARTY_NOTICES
  section 8 for the full notice.

  URDF link/joint names follow genie_robot_description's hand naming
  convention (see docs/naming_convention.hand.md in that repo):
    - prefix `hand_l` / `hand_r` (not `left` / `right`) on links and joints
    - fingers named `thumb` / `index` / `middle` / `ring` / `pinky`
      (not `finger1..finger5`) — mapping is 1:1 with the source fid
    - fingertip pads use `_pad_link` suffix (real link with geometry +
      inertial); the legacy `_tip_link` suffix is retired
    - hand joints do NOT carry the global `idx{NN}` prefix used by
      body / arm / chassis / parallel-gripper joints

  Only the framework adapter differs from the upstream source: genie_sim's
  gripper framework calls every gripper through a `gripper` macro with a
  uniform signature (side parent_link xyz_offset rpy_offset collision_type
  mesh_dir app). That adapter macro at the bottom of this file is
  AgiBot-authored and covered by the package-level license.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== inlined constants (source const.xacro) ===================== -->
    <!-- ==================================================================== -->
    <!-- All per-side / per-finger numeric data, kept faithful to the source  -->
    <!-- urdf (left.urdf / right.urdf). Values are organised as xacro python   -->
    <!-- dictionaries so the finger macro can look them up by (side, fid).     -->
    <!--                                                                       -->
    <!-- NOTE: xacro's ${...} lexer cannot handle literal '{' '}' braces, so   -->
    <!-- every dict is built with dict([(key, value), ...]) instead of {}.     -->
    <!-- ==================================================================== -->

    <!-- palm centre-of-mass per side -->
    <xacro:property name="palm_com" value="${dict(
        right=[-0.002979471, 0.0004557176, 0.03665409],
        left=[-0.002978793, -0.0004525509, 0.03665471])}" />
    <xacro:property name="palm_mass" value="0.16914" />
    <xacro:property name="palm_inertia" value="${dict(
        ixx=0.00014, ixy=2.54e-06, ixz=6.91e-06, iyy=9.47e-05, iyz=-6.63e-06, izz=6e-05)}" />

