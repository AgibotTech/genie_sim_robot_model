    <!-- ==================================================================== -->
    <!-- joint rotation axes.                                                  -->
    <!-- Nearly every revolute joint spins about +Y (0 1 0); the only          -->
    <!-- exception in the source urdf is left finger1 joint2, which is 0 -1 0. -->
    <!-- Only the non-default entries are stored here; the finger macro falls   -->
    <!-- back to [0, 1, 0] for everything else.                                -->
    <!-- ==================================================================== -->
    <xacro:property name="joint_axis_default" value="${[0, 1, 0]}" />
    <xacro:property name="joint_axis" value="${dict(
        left=dict([
            (1, dict([
                (2, [0, -1, 0])]))]))}" />

    <!-- ==================================================================== -->
    <!-- joint limits: identical across sides, keyed by (fid, joint)           -->
    <!-- each entry = [lower, upper, effort, velocity]                         -->
    <!-- ==================================================================== -->
    <xacro:property name="joint_limit" value="${dict([
        (1, dict([
            (1, [0.0475, 1.6033, 0.4452, 8.587]),
            (2, [-0.1387, 0.9324, 0.4259, 11.1]),
            (3, [-0.4642, 1.5623, 0.1888, 12.863]),
            (4, [-0.4699, 1.5568, 0.1468, 13.578])])),
        (2, dict([
            (1, [-0.1585, 1.5604, 0.6188, 8.203]),
            (2, [-0.3700, 0.3700, 0.1822, 8.115]),
            (3, [-0.4777, 1.5485, 0.2251, 12.863]),
            (4, [-0.4683, 1.5753, 0.2170, 13.578])])),
        (3, dict([
            (1, [-0.1644, 1.5516, 0.6494, 8.203]),
            (2, [-0.3700, 0.3700, 0.1827, 8.115]),
            (3, [-0.4739, 1.5512, 0.2078, 12.863]),
            (4, [-0.4684, 1.5745, 0.2018, 13.578])])),
        (4, dict([
            (1, [-0.1554, 1.5585, 0.6389, 8.203]),
            (2, [-0.3700, 0.3700, 0.1832, 8.115]),
            (3, [-0.4765, 1.5487, 0.2249, 12.863]),
            (4, [-0.4777, 1.5634, 0.2044, 13.578])])),
        (5, dict([
            (1, [-0.1626, 1.5585, 0.6441, 8.203]),
            (2, [-0.3700, 0.3700, 0.1798, 8.115]),
            (3, [-0.4768, 1.5490, 0.2384, 12.863]),
            (4, [-0.4683, 1.5735, 0.1866, 13.578])]))])}" />

  <!-- ===================== inlined finger macro (source finger.xacro) ===================== -->
    <!-- ==================================================================== -->
    <!-- One finger of the wuji hand.                                          -->
    <!-- Topology: link1 -> link2 -> link3 -> link4 -> pad                     -->
    <!--           4 revolute joints (joint1..joint4) + 1 fixed pad joint.     -->
    <!--                                                                       -->
    <!-- Naming per genie_robot_description/docs/naming_convention.hand.md:    -->
    <!--   - link/joint prefix is `hand_l` / `hand_r` (not `left` / `right`)   -->
    <!--   - fingers named thumb / index / middle / ring / pinky (not fid)     -->
    <!--   - fingertip pad uses `_pad_link` suffix (real link, keeps           -->
    <!--     geometry + inertial); `_tip_link` is NOT used                     -->
    <!--   - no `idx{NN}` prefix on hand joints                                -->
    <!--                                                                       -->
    <!-- Params:                                                               -->
    <!--   prefix      : URDF link/joint prefix ('hand_l' or 'hand_r')         -->
    <!--   side        : mesh dir / const dict lookup key ('left' / 'right')   -->
    <!--   fid         : integer finger id 1..5 (into const dicts)             -->
    <!--   finger_name : anatomical name (embedded in link/joint names)        -->
    <!--   mesh_path   : directory holding the STL meshes for this side        -->
    <!-- ==================================================================== -->
    <xacro:macro name="wuji_finger" params="prefix side fid finger_name mesh_path">

        <!-- pick the shared (thumb / other) mass+inertia table for this finger -->
        <xacro:property name="grp" value="${'thumb' if fid == 1 else 'other'}" />

        <!-- per-finger axis lookup: default +Y, overridden only where the urdf differs -->
        <xacro:property name="axis_fid" value="${joint_axis.get(side, dict()).get(fid, dict())}" />

        <!-- ============================ link1 ============================ -->
        <link name="${prefix}_${finger_name}_link1">
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${link_com[side][fid][1][0]} ${link_com[side][fid][1][1]} ${link_com[side][fid][1][2]}" />
                <mass value="${link_mass[grp][1]}" />
                <inertia ixx="${link_inertia[grp][1]['ixx']}" ixy="${link_inertia[grp][1]['ixy']}"
                    ixz="${link_inertia[grp][1]['ixz']}" iyy="${link_inertia[grp][1]['iyy']}"
                    iyz="${link_inertia[grp][1]['iyz']}" izz="${link_inertia[grp][1]['izz']}" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/${side}_finger${fid}_link1.STL" />
                </geometry>
                <material name="hand_color" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/${side}_finger${fid}_link1.STL" />
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}_${finger_name}_joint1" type="revolute">
            <origin
                xyz="${joint_xyz[side][fid][1][0]} ${joint_xyz[side][fid][1][1]} ${joint_xyz[side][fid][1][2]}"
                rpy="${joint_rpy[side][fid][1][0]} ${joint_rpy[side][fid][1][1]} ${joint_rpy[side][fid][1][2]}" />
            <parent link="${prefix}_base_link" />
            <child link="${prefix}_${finger_name}_link1" />
            <axis xyz="${axis_fid.get(1, joint_axis_default)[0]} ${axis_fid.get(1, joint_axis_default)[1]} ${axis_fid.get(1, joint_axis_default)[2]}" />
            <limit lower="${joint_limit[fid][1][0]}" upper="${joint_limit[fid][1][1]}"
                effort="${joint_limit[fid][1][2]}" velocity="${joint_limit[fid][1][3]}" />
        </joint>

        <!-- ============================ link2 ============================ -->
        <link name="${prefix}_${finger_name}_link2">
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${link_com[side][fid][2][0]} ${link_com[side][fid][2][1]} ${link_com[side][fid][2][2]}" />
                <mass value="${link_mass[grp][2]}" />
                <inertia ixx="${link_inertia[grp][2]['ixx']}" ixy="${link_inertia[grp][2]['ixy']}"
                    ixz="${link_inertia[grp][2]['ixz']}" iyy="${link_inertia[grp][2]['iyy']}"
                    iyz="${link_inertia[grp][2]['iyz']}" izz="${link_inertia[grp][2]['izz']}" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/${side}_finger${fid}_link2.STL" />
                </geometry>
                <material name="hand_color" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/${side}_finger${fid}_link2.STL" />
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}_${finger_name}_joint2" type="revolute">
            <origin
                xyz="${joint_xyz[side][fid][2][0]} ${joint_xyz[side][fid][2][1]} ${joint_xyz[side][fid][2][2]}"
                rpy="${joint_rpy[side][fid][2][0]} ${joint_rpy[side][fid][2][1]} ${joint_rpy[side][fid][2][2]}" />
            <parent link="${prefix}_${finger_name}_link1" />
            <child link="${prefix}_${finger_name}_link2" />
            <axis xyz="${axis_fid.get(2, joint_axis_default)[0]} ${axis_fid.get(2, joint_axis_default)[1]} ${axis_fid.get(2, joint_axis_default)[2]}" />
            <limit lower="${joint_limit[fid][2][0]}" upper="${joint_limit[fid][2][1]}"
                effort="${joint_limit[fid][2][2]}" velocity="${joint_limit[fid][2][3]}" />
        </joint>

        <!-- ============================ link3 ============================ -->
        <link name="${prefix}_${finger_name}_link3">
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${link_com[side][fid][3][0]} ${link_com[side][fid][3][1]} ${link_com[side][fid][3][2]}" />
                <mass value="${link_mass[grp][3]}" />
                <inertia ixx="${link_inertia[grp][3]['ixx']}" ixy="${link_inertia[grp][3]['ixy']}"
                    ixz="${link_inertia[grp][3]['ixz']}" iyy="${link_inertia[grp][3]['iyy']}"
                    iyz="${link_inertia[grp][3]['iyz']}" izz="${link_inertia[grp][3]['izz']}" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/${side}_finger${fid}_link3.STL" />
                </geometry>
                <material name="hand_color" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/${side}_finger${fid}_link3.STL" />
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}_${finger_name}_joint3" type="revolute">
            <origin
                xyz="${joint_xyz[side][fid][3][0]} ${joint_xyz[side][fid][3][1]} ${joint_xyz[side][fid][3][2]}"
                rpy="${joint_rpy[side][fid][3][0]} ${joint_rpy[side][fid][3][1]} ${joint_rpy[side][fid][3][2]}" />
            <parent link="${prefix}_${finger_name}_link2" />
            <child link="${prefix}_${finger_name}_link3" />
            <axis xyz="${axis_fid.get(3, joint_axis_default)[0]} ${axis_fid.get(3, joint_axis_default)[1]} ${axis_fid.get(3, joint_axis_default)[2]}" />
            <limit lower="${joint_limit[fid][3][0]}" upper="${joint_limit[fid][3][1]}"
                effort="${joint_limit[fid][3][2]}" velocity="${joint_limit[fid][3][3]}" />
        </joint>

        <!-- ============================ link4 ============================ -->
        <link name="${prefix}_${finger_name}_link4">
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${link_com[side][fid][4][0]} ${link_com[side][fid][4][1]} ${link_com[side][fid][4][2]}" />
                <mass value="${link_mass[grp][4]}" />
                <inertia ixx="${link_inertia[grp][4]['ixx']}" ixy="${link_inertia[grp][4]['ixy']}"
                    ixz="${link_inertia[grp][4]['ixz']}" iyy="${link_inertia[grp][4]['iyy']}"
                    iyz="${link_inertia[grp][4]['iyz']}" izz="${link_inertia[grp][4]['izz']}" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/${side}_finger${fid}_link4.STL" />
                </geometry>
                <material name="hand_color" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/${side}_finger${fid}_link4.STL" />
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}_${finger_name}_joint4" type="revolute">
            <origin
                xyz="${joint_xyz[side][fid][4][0]} ${joint_xyz[side][fid][4][1]} ${joint_xyz[side][fid][4][2]}"
                rpy="${joint_rpy[side][fid][4][0]} ${joint_rpy[side][fid][4][1]} ${joint_rpy[side][fid][4][2]}" />
            <parent link="${prefix}_${finger_name}_link3" />
            <child link="${prefix}_${finger_name}_link4" />
            <axis xyz="${axis_fid.get(4, joint_axis_default)[0]} ${axis_fid.get(4, joint_axis_default)[1]} ${axis_fid.get(4, joint_axis_default)[2]}" />
            <limit lower="${joint_limit[fid][4][0]}" upper="${joint_limit[fid][4][1]}"
                effort="${joint_limit[fid][4][2]}" velocity="${joint_limit[fid][4][3]}" />
        </joint>

        <!-- ============================= pad ============================= -->
        <!-- Contact pad (real link with geometry + inertial). Naming per       -->
        <!-- naming_convention.hand.md §2.4: `_pad_link` suffix denotes a       -->
        <!-- physical contact body, distinct from a virtual `_tip` frame.       -->
        <!-- Mesh file keeps its historical `_tip_link.STL` filename.           -->
        <link name="${prefix}_${finger_name}_pad_link">
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${link_com[side][fid][5][0]} ${link_com[side][fid][5][1]} ${link_com[side][fid][5][2]}" />
                <mass value="${link_mass[grp][5]}" />
                <inertia ixx="${link_inertia[grp][5]['ixx']}" ixy="${link_inertia[grp][5]['ixy']}"
                    ixz="${link_inertia[grp][5]['ixz']}" iyy="${link_inertia[grp][5]['iyy']}"
                    iyz="${link_inertia[grp][5]['iyz']}" izz="${link_inertia[grp][5]['izz']}" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/${side}_finger${fid}_tip_link.STL" />
                </geometry>
                <material name="hand_color" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <mesh filename="${mesh_path}/${side}_finger${fid}_tip_link.STL" />
                </geometry>
            </collision>
        </link>

        <joint name="${prefix}_${finger_name}_pad_joint" type="fixed">
            <origin
                xyz="${joint_xyz[side][fid][5][0]} ${joint_xyz[side][fid][5][1]} ${joint_xyz[side][fid][5][2]}"
                rpy="0 0 0" />
            <parent link="${prefix}_${finger_name}_link4" />
            <child link="${prefix}_${finger_name}_pad_link" />
        </joint>

    </xacro:macro>

  <!-- shade matching the original urdf material colour -->
  <material name="hand_color">
    <color rgba="0.8980392 0.9176471 0.9294118 1" />
  </material>

  <!-- ==================================================================== -->
  <!-- genie_sim framework adapter.                                          -->
  <!-- Maps the uniform gripper signature onto the native wuji_hand macro.   -->
  <!--   side       : 'l' / 'r' (genie_sim convention)                        -->
  <!--                -> prefix 'hand_l' / 'hand_r' for URDF names            -->
  <!--                -> wside  'left'   / 'right'  for mesh dir + const dicts -->
  <!--   mesh_dir   : root mesh dir; meshes live in mesh_dir/gripper/wuji/<wside> -->
  <!--   collision_type / app : accepted for signature parity, unused here.  -->
  <!--                                                                        -->
  <!-- Naming follows genie_robot_description/docs/naming_convention.hand.md: -->
  <!-- link/joint prefix is `hand_l` / `hand_r`, no `idx{NN}` on hand joints, -->
  <!-- fingertips use `_pad_link` (real) instead of the legacy `_tip_link`.   -->
  <!-- ==================================================================== -->
  <xacro:macro name="gripper"
    params="side parent_link xyz_offset rpy_offset collision_type mesh_dir app">
    <xacro:property name="wside" value="${'left' if side == 'l' else 'right'}" />
    <xacro:wuji_hand
      prefix="hand_${side}"
      side="${wside}"
      mesh_path="${mesh_dir}/gripper/wuji/${wside}"
      parent_link="${parent_link}"
      xyz_offset="${xyz_offset}"
      rpy_offset="${rpy_offset}"
      attach="true" />
  </xacro:macro>

  <!-- ==================================================================== -->
  <!-- Full wuji hand assembly macro.                                        -->
  <!--   prefix     : URDF link/joint prefix ('hand_l' / 'hand_r')           -->
  <!--   side       : 'right' or 'left' (selects the parameter set + meshes) -->
  <!--   mesh_path  : directory holding the STL meshes for this side         -->
  <!--   parent_link: link the palm is attached to                           -->
  <!--   xyz_offset / rpy_offset : pose of the palm w.r.t. the parent        -->
  <!-- Builds: palm (as `_base_link`) + 5 fingers (each 4 revolute + 1 pad). -->
  <!-- ==================================================================== -->
  <xacro:macro name="wuji_hand"
    params="prefix side mesh_path parent_link:='world' xyz_offset:='0 0 0' rpy_offset:='0 0 0' attach:=true">

    <!-- ============================= palm ============================= -->
    <!-- Wuji has a single palm segment that also serves as the arm-side    -->
    <!-- mount, so we use `_base_link` (not `_palm_1`) per                  -->
    <!-- naming_convention.hand.md §2.1.                                    -->
    <link name="${prefix}_base_link">
      <inertial>
        <origin rpy="0 0 0"
          xyz="${palm_com[side][0]} ${palm_com[side][1]} ${palm_com[side][2]}" />
        <mass value="${palm_mass}" />
        <inertia ixx="${palm_inertia['ixx']}" ixy="${palm_inertia['ixy']}"
          ixz="${palm_inertia['ixz']}" iyy="${palm_inertia['iyy']}"
          iyz="${palm_inertia['iyz']}" izz="${palm_inertia['izz']}" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_path}/${side}_palm_link_01.STL" />
        </geometry>
        <material name="hand_color" />
      </visual>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_path}/${side}_palm_link_02.STL" />
        </geometry>
        <material name="hand_color" />
      </visual>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_path}/${side}_palm_link_03.STL" />
        </geometry>
        <material name="hand_color" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_path}/${side}_palm_link_collision_01.STL" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_path}/${side}_palm_link_collision_02.STL" />
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_path}/${side}_palm_link_collision_03.STL" />
        </geometry>
      </collision>
    </link>

    <xacro:if value="${attach}">
      <joint name="${prefix}_base_joint" type="fixed">
        <origin xyz="${xyz_offset}" rpy="${rpy_offset}" />
        <parent link="${parent_link}" />
        <child link="${prefix}_base_link" />
      </joint>
    </xacro:if>

    <!-- ============================ fingers =========================== -->
    <!-- fid → finger_name mapping: 1=thumb, 2=index, 3=middle, 4=ring, 5=pinky -->
    <xacro:wuji_finger prefix="${prefix}" side="${side}" fid="1" finger_name="thumb"  mesh_path="${mesh_path}" />
    <xacro:wuji_finger prefix="${prefix}" side="${side}" fid="2" finger_name="index"  mesh_path="${mesh_path}" />
    <xacro:wuji_finger prefix="${prefix}" side="${side}" fid="3" finger_name="middle" mesh_path="${mesh_path}" />
    <xacro:wuji_finger prefix="${prefix}" side="${side}" fid="4" finger_name="ring"   mesh_path="${mesh_path}" />
    <xacro:wuji_finger prefix="${prefix}" side="${side}" fid="5" finger_name="pinky"  mesh_path="${mesh_path}" />

  </xacro:macro>
</robot>
